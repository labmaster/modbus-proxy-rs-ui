[Unit]
Description=Modbus proxy web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=modbusui
Group=modbusui
# read the journal statistics (System page)
SupplementaryGroups=systemd-journal
ExecStart=/usr/local/bin/modbusui -listen :80
Restart=always
RestartSec=30

# no logs
StandardOutput=null
StandardError=null
LogLevelMax=notice

# port 80 without root: only this one capability
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# sandbox: the UI may only write to its spool directory
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/modbusui/spool
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
