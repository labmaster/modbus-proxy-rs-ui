# Shell scripts and systemd units must keep LF line endings, also when checked out on Windows.
*.sh       text eol=lf
*.service  text eol=lf
*.path     text eol=lf
*.yml      text eol=lf
*.py       text eol=lf
*.go       text eol=lf
*.js       text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.md       text eol=lf
